{
	"title": "Mustache Variables Registry",
	"description": "Registry of all mustache template variables used in the block theme scaffold",
	"type": "object",
	"properties": {
		"ThemeSlug": {
			"type": "string",
			"description": "Auto-discovered placeholder (other)",
			"examples": ["ThemeSlug"]
		},
		"YYYYMMDD": {
			"type": "string",
			"description": "Auto-discovered placeholder (other)",
			"examples": ["YYYYMMDD"]
		},
		"accent_color": {
			"type": "string",
			"description": "Accent color (hex format)",
			"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
			"examples": ["#ff6600", "#00ff00"]
		},
		"agent_role": {
			"type": "string",
			"description": "Auto-discovered placeholder (other)",
			"examples": ["agent_role"]
		},
		"agent_slug": {
			"type": "string",
			"description": "Auto-discovered placeholder (other)",
			"examples": ["agent_slug"]
		},
		"agent_summary": {
			"type": "string",
			"description": "Auto-discovered placeholder (other)",
			"examples": ["agent_summary"]
		},
		"agent_title": {
			"type": "string",
			"description": "Auto-discovered placeholder (content_strings)",
			"examples": ["agent_title"]
		},
		"agent_version": {
			"type": "string",
			"description": "Auto-discovered placeholder (versioning)",
			"examples": ["agent_version"]
		},
		"agent_workflow": {
			"type": "string",
			"description": "Auto-discovered placeholder (other)",
			"examples": ["agent_workflow"]
		},
		"archive_excerpt_length": {
			"type": "string",
			"description": "Archive page excerpt length in words",
			"pattern": "^\\d+$",
			"default": "55",
			"examples": ["55", "75", "100"]
		},
		"author": {
			"type": "string",
			"description": "Theme author name",
			"minLength": 2,
			"examples": ["LightSpeed", "Your Name"]
		},
		"author_uri": {
			"type": "string",
			"description": "Theme author website URL",
			"format": "uri",
			"pattern": "^https?://",
			"examples": ["https://lightspeedwp.agency", "https://example.com"]
		},
		"author_username": {
			"type": "string",
			"description": "Author username (for GitHub, etc.)",
			"examples": ["lightspeedwp", "username"]
		},
		"background_color": {
			"type": "string",
			"description": "Background color (hex format)",
			"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
			"default": "#ffffff",
			"examples": ["#ffffff", "#fff"]
		},
		"body_font": {
			"type": "string",
			"description": "Body font reference",
			"examples": ["system-ui", "Inter"]
		},
		"body_font_family": {
			"type": "string",
			"description": "Body font family (CSS font-family value)",
			"default": "system-ui",
			"examples": ["system-ui", "Inter, sans-serif", "Georgia, serif"]
		},
		"body_font_name": {
			"type": "string",
			"description": "Body font name (for theme.json)",
			"examples": ["System UI", "Inter", "Georgia"]
		},
		"body_line_height": {
			"type": "string",
			"description": "Body text line height",
			"pattern": "^\\d+(\\.\\d+)?$",
			"default": "1.6",
			"examples": ["1.6", "1.5", "1.75"]
		},
		"boundaries_and_context": {
			"type": "string",

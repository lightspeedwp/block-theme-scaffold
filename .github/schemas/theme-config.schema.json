{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://lightspeedwp.com/schemas/theme-config.json",
	"title": "WordPress Block Theme Configuration",
	"description": "Complete configuration for theme generation wizard. Fill in values and pass to generate-theme with --config flag. Supports 142 mustache variables discovered via scripts/scan-mustache-variables.js",
	"type": "object",
	"required": ["theme_slug", "theme_name", "author"],
	"properties": {
		"_comment": {
			"type": "string",
			"default": "Fill in the values below and save as theme-config.json, then run: node scripts/generate-theme.js --config theme-config.json"
		},
		"wizard_mode": {
			"type": "string",
			"description": "Wizard complexity level: 'basic' (essential values only) or 'advanced' (all customization options)",
			"enum": ["basic", "advanced"],
			"default": "basic"
		},
		"theme_slug": {
			"type": "string",
			"description": "URL-safe theme identifier (lowercase, hyphens only)",
			"pattern": "^[a-z0-9-]{2,}$",
			"examples": ["tour-starter", "my-theme-2024", "company-blog"]
		},
		"theme_name": {
			"type": "string",
			"description": "Human-readable theme name shown in WordPress admin",
			"minLength": 2,
			"examples": [
				"Tour Starter Theme",
				"My Business Site",
				"E-Commerce Pro"
			]
		},
		"description": {
			"type": "string",
			"description": "Brief theme description (1-2 sentences)",
			"default": "A modern WordPress block theme built with accessibility and performance in mind.",
			"examples": [
				"A WordPress block theme for tour operators and travel businesses.",
				"A professional block theme with advanced design system."
			]
		},
		"author": {
			"type": "string",
			"description": "Author or organization name",
			"default": "Your Name or Company",
			"examples": ["LightSpeed", "Acme Corporation", "Jane Developer"]
		},
		"author_uri": {
			"type": "string",
			"description": "Author website URL (must include protocol)",
			"format": "uri",
			"pattern": "^https?://",
			"default": "https://example.com",
			"examples": [
				"https://developer.lsdev.biz",
				"https://yourcompany.com"
			]
		},
		"author_username": {
			"type": "string",
			"description": "WordPress.org username for theme author",
			"default": "",
			"examples": ["lightspeed-wp", "john-developer"]
		},
		"version": {
			"type": "string",
			"description": "Starting version number (semantic versioning)",
			"pattern": "^\\d+\\.\\d+(\\.\\d+)?(-[a-zA-Z0-9.-]+)?$",
			"default": "1.0.0",
			"examples": ["1.0.0", "2.1.0", "1.0.0-beta.1"]
		},
		"min_wp_version": {
			"type": "string",
			"description": "Minimum required WordPress version",
			"pattern": "^\\d+\\.\\d+$",
			"default": "6.5",
			"examples": ["6.5", "6.7"]
		},
		"tested_wp_version": {
			"type": "string",
			"description": "Tested up to WordPress version",
			"pattern": "^\\d+\\.\\d+$",
			"default": "6.7",
			"examples": ["6.7", "6.8"]
		},
		"min_php_version": {
			"type": "string",
			"description": "Minimum required PHP version",
			"pattern": "^\\d+\\.\\d+$",
			"default": "8.0",
			"examples": ["8.0", "8.1", "8.2"]
		},
		"license": {
			"type": "string",
			"description": "Theme license identifier",
			"default": "GPL-2.0-or-later",
			"examples": ["GPL-2.0-or-later", "GPL-3.0", "MIT"]
		},
		"license_uri": {
			"type": "string",
			"description": "URL to full license text",
			"format": "uri",
			"default": "https://www.gnu.org/licenses/gpl-2.0.html"
		},
		"theme_uri": {
			"type": "string",
			"description": "Theme homepage URL",
			"format": "uri",
			"pattern": "^https?://",
			"default": "https://example.com/theme"
		},
		"theme_tags": {
			"type": "string",
			"description": "Comma-separated WordPress theme tags",
			"default": "block-patterns, block-styles, custom-colors, custom-menu, editor-style, featured-images, full-site-editing, template-editing, wide-blocks",
			"examples": [
				"blog, custom-header, featured-images",
				"e-commerce, woocommerce, shop"
			]
		},
		"target_audience": {
			"type": "string",
			"description": "Target audience description",
			"default": "bloggers and content creators",
			"examples": [
				"tour operators and travel agencies",
				"small businesses and startups",
				"photographers and creative professionals"
			]
		},
		"urls": {
			"type": "object",
			"description": "URLs for theme resources and support",
			"properties": {
				"theme_repo_url": {
					"type": "string",
					"description": "Git repository URL (auto-generated from author + theme_slug if not provided)",
					"format": "uri",
					"examples": ["https://github.com/lightspeedwp/tour-starter"]
				},
				"support_url": {
					"type": "string",
					"description": "Support forum/page URL",
					"format": "uri",
					"examples": [
						"https://wordpress.org/support/theme/tour-starter"
					]
				},
				"docs_url": {
					"type": "string",
					"description": "Documentation URL",
					"format": "uri",
					"examples": [
						"https://github.com/lightspeedwp/tour-starter/wiki"
					]
				},
				"changelog_url": {
					"type": "string",
					"description": "Changelog URL",
					"format": "uri",
					"examples": [
						"https://github.com/lightspeedwp/tour-starter/releases"
					]
				},
				"discord_url": {
					"type": "string",
					"description": "Discord community URL",
					"format": "uri",
					"default": ""
				},
				"premium_support_url": {
					"type": "string",
					"description": "Premium support page URL",
					"format": "uri",
					"default": ""
				}
			}
		},
		"emails": {
			"type": "object",
			"description": "Contact email addresses (auto-generated from author_uri domain if not provided)",
			"properties": {
				"support_email": {
					"type": "string",
					"description": "Support email address",
					"format": "email",
					"examples": ["support@example.com"]
				},
				"security_email": {
					"type": "string",
					"description": "Security issues email",
					"format": "email",
					"examples": ["security@example.com"]
				},
				"business_email": {
					"type": "string",
					"description": "Business inquiries email",
					"format": "email",
					"examples": ["contact@example.com"]
				}
			}
		},
		"design_system": {
			"type": "object",
			"description": "Design tokens for colors, typography, and spacing",
			"properties": {
				"colors": {
					"type": "object",
					"description": "Color palette (hex format: #RRGGBB or #RRGGBBAA)",
					"properties": {
						"primary_color": {
							"type": "string",
							"description": "Primary brand color",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#0073aa",
							"examples": ["#0073aa", "#1e40af", "#7c3aed"]
						},
						"secondary_color": {
							"type": "string",
							"description": "Secondary brand color",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#005177",
							"examples": ["#005177", "#1e3a8a"]
						},
						"background_color": {
							"type": "string",
							"description": "Default background color",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#ffffff",
							"examples": ["#ffffff", "#f9fafb", "#111827"]
						},
						"text_color": {
							"type": "string",
							"description": "Default text color (ensure WCAG contrast with background)",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#1a1a1a",
							"examples": ["#1a1a1a", "#111827", "#374151"]
						},
						"accent_color": {
							"type": "string",
							"description": "Accent/CTA color",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#ff6b35",
							"examples": ["#ff6b35", "#f59e0b", "#ec4899"]
						},
						"neutral_color": {
							"type": "string",
							"description": "Neutral/gray color",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#6c757d",
							"examples": ["#6c757d", "#9ca3af", "#64748b"]
						}
					}
				},
				"dark_mode_colors": {
					"type": "object",
					"description": "Dark mode color palette (optional, for dark style variation)",
					"properties": {
						"dark_background_color": {
							"type": "string",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#1a1a1a"
						},
						"dark_text_color": {
							"type": "string",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#ffffff"
						},
						"dark_primary_color": {
							"type": "string",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#4a9eff"
						},
						"dark_accent_color": {
							"type": "string",
							"pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$",
							"default": "#ff8c5a"
						}
					}
				},
				"typography": {
					"type": "object",
					"description": "Font families and typography settings",
					"properties": {
						"heading_font_family": {
							"type": "string",
							"description": "CSS font stack for headings (include fallbacks)",
							"default": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
							"examples": [
								"\"Poppins\", \"Inter\", system-ui, sans-serif",
								"\"Playfair Display\", Georgia, serif",
								"system-ui, -apple-system, sans-serif"
							]
						},
						"heading_font_name": {
							"type": "string",
							"description": "Display name for headings font",
							"default": "System Font",
							"examples": [
								"Poppins",
								"Playfair Display",
								"System Font"
							]
						},
						"body_font_family": {
							"type": "string",
							"description": "CSS font stack for body text (include fallbacks)",
							"default": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
							"examples": [
								"\"Inter\", -apple-system, BlinkMacSystemFont, sans-serif",
								"Georgia, \"Times New Roman\", serif",
								"system-ui, sans-serif"
							]
						},
						"body_font_name": {
							"type": "string",
							"description": "Display name for body font",
							"default": "System Font",
							"examples": ["Inter", "Georgia", "System Font"]
						},
						"mono_font_family": {
							"type": "string",
							"description": "CSS font stack for monospace/code text",
							"default": "\"Fira Code\", \"Courier New\", monospace",
							"examples": [
								"\"Fira Code\", monospace",
								"\"JetBrains Mono\", \"Courier New\", monospace"
							]
						},
						"mono_font_name": {
							"type": "string",
							"description": "Display name for monospace font",
							"default": "Monospace",
							"examples": ["Fira Code", "JetBrains Mono"]
						},
						"heading_font_weight": {
							"type": "string",
							"description": "Font weight for headings (100-900)",
							"pattern": "^[1-9]00$",
							"default": "700",
							"examples": ["400", "600", "700", "800"]
						},
						"body_line_height": {
							"type": "string",
							"description": "Line height for body text (unitless)",
							"pattern": "^\\d+(\\.\\d+)?$",
							"default": "1.6",
							"examples": ["1.5", "1.6", "1.8"]
						},
						"heading_line_height": {
							"type": "string",
							"description": "Line height for headings (unitless)",
							"pattern": "^\\d+(\\.\\d+)?$",
							"default": "1.2",
							"examples": ["1.1", "1.2", "1.3"]
						},
						"button_font_weight": {
							"type": "string",
							"description": "Font weight for buttons (100-900)",
							"pattern": "^[1-9]00$",
							"default": "600",
							"examples": ["500", "600", "700"]
						},
						"site_title_font_weight": {
							"type": "string",
							"description": "Font weight for site title (100-900)",
							"pattern": "^[1-9]00$",
							"default": "700",
							"examples": ["600", "700", "800"]
						}
					}
				},
				"layout": {
					"type": "object",
					"description": "Content width and layout settings",
					"properties": {
						"content_width": {
							"type": "string",
							"description": "Maximum width for content (with unit)",
							"pattern": "^\\d+(px|rem|em)$",
							"default": "720px",
							"examples": ["720px", "768px", "45rem"]
						},
						"wide_width": {
							"type": "string",
							"description": "Maximum width for wide blocks (with unit)",
							"pattern": "^\\d+(px|rem|em)$",
							"default": "1200px",
							"examples": ["1200px", "1440px", "75rem"]
						}
					}
				}
			}
		},
		"images": {
			"type": "object",
			"description": "Image size definitions",
			"properties": {
				"featured_image_width": {
					"type": "integer",
					"description": "Featured image width in pixels",
					"default": 1200,
					"examples": [1200, 1920, 2400]
				},
				"featured_image_height": {
					"type": "integer",
					"description": "Featured image height in pixels",
					"default": 675,
					"examples": [675, 1080, 1350]
				},
				"thumbnail_width": {
					"type": "integer",
					"description": "Thumbnail width in pixels",
					"default": 300,
					"examples": [300, 400, 500]
				},
				"thumbnail_height": {
					"type": "integer",
					"description": "Thumbnail height in pixels",
					"default": 300,
					"examples": [300, 400, 500]
				},
				"gallery_image_width": {
					"type": "integer",
					"description": "Gallery image width in pixels",
					"default": 800,
					"examples": [800, 1024, 1200]
				},
				"gallery_image_height": {
					"type": "integer",
					"description": "Gallery image height in pixels",
					"default": 600,
					"examples": [600, 768, 900]
				},
				"logo_width": {
					"type": "integer",
					"description": "Custom logo width in pixels",
					"default": 250,
					"examples": [200, 250, 300]
				},
				"logo_height": {
					"type": "integer",
					"description": "Custom logo height in pixels",
					"default": 100,
					"examples": [80, 100, 120]
				}
			}
		},
		"content": {
			"type": "object",
			"description": "Default content strings and settings",
			"properties": {
				"excerpt_length": {
					"type": "integer",
					"description": "Number of words in excerpts",
					"default": 55,
					"minimum": 20,
					"maximum": 200
				},
				"archive_excerpt_length": {
					"type": "integer",
					"description": "Number of words in archive/listing excerpts",
					"default": 40,
					"minimum": 20,
					"maximum": 200
				},
				"excerpt_more": {
					"type": "string",
					"description": "Excerpt 'more' text",
					"default": "..."
				},
				"skip_link_text": {
					"type": "string",
					"description": "Skip to content link text",
					"default": "Skip to content"
				},
				"button_border_radius": {
					"type": "string",
					"description": "Default button border radius",
					"default": "4px",
					"examples": ["0", "4px", "8px", "9999px"]
				},
				"hero_title": {
					"type": "string",
					"description": "Default hero section title",
					"default": "Welcome to Your New Website",
					"examples": [
						"Discover Your Next Adventure",
						"Transform Your Business"
					]
				},
				"hero_description": {
					"type": "string",
					"description": "Default hero section description",
					"default": "This is a modern WordPress block theme built with performance and accessibility in mind.",
					"examples": [
						"Explore amazing destinations with expert guides"
					]
				},
				"hero_button_text": {
					"type": "string",
					"description": "Default hero CTA button text",
					"default": "Get Started",
					"examples": ["Book Now", "Learn More", "Start Your Journey"]
				},
				"cta_title": {
					"type": "string",
					"description": "Default call-to-action section title",
					"default": "Ready to Get Started?",
					"examples": ["Book Your Adventure Today"]
				},
				"cta_description": {
					"type": "string",
					"description": "Default call-to-action description",
					"default": "Join thousands of satisfied customers.",
					"examples": [
						"Don't miss out on the experience of a lifetime"
					]
				},
				"cta_button_text": {
					"type": "string",
					"description": "Default CTA button text",
					"default": "Contact Us",
					"examples": ["Book Now", "Get in Touch"]
				},
				"footer_text": {
					"type": "string",
					"description": "Footer copyright text ({{year}} and {{author}} will be replaced)",
					"default": "© {{year}} {{author}}. All rights reserved."
				}
			}
		},
		"theme_structure": {
			"type": "object",
			"description": "Define which template parts, patterns, and style variations to include",
			"properties": {
				"template_parts": {
					"type": "array",
					"description": "Template parts to include in theme",
					"default": [
						"header",
						"footer",
						"sidebar",
						"post-meta",
						"pagination",
						"comments"
					],
					"items": {
						"type": "string",
						"enum": [
							"header",
							"footer",
							"sidebar",
							"post-meta",
							"pagination",
							"comments"
						]
					}
				},
				"templates": {
					"type": "array",
					"description": "Templates to include in theme",
					"default": [
						"index",
						"home",
						"single",
						"page",
						"archive",
						"search",
						"404"
					],
					"items": {
						"type": "string",
						"enum": [
							"index",
							"home",
							"home-sidebar",
							"front-page",
							"single",
							"page",
							"archive",
							"category",
							"tag",
							"author",
							"search",
							"404",
							"singular"
						]
					}
				},
				"patterns": {
					"type": "array",
					"description": "Block patterns to include",
					"default": [
						"header",
						"footer",
						"hero",
						"call-to-action",
						"features",
						"testimonials",
						"post-card",
						"post-meta",
						"pagination"
					],
					"items": {
						"type": "string",
						"enum": [
							"header",
							"footer",
							"hero",
							"call-to-action",
							"features",
							"testimonials",
							"post-card",
							"post-meta",
							"pagination",
							"sidebar",
							"comments",
							"archive-header",
							"author-header",
							"single-post-content",
							"no-search-results",
							"404-content",
							"query-posts-grid",
							"query-posts-list"
						]
					}
				},
				"pattern_categories": {
					"type": "array",
					"description": "Custom pattern categories",
					"default": [
						"headers",
						"footers",
						"call-to-action",
						"testimonials",
						"featured"
					],
					"items": {
						"type": "object",
						"properties": {
							"slug": {
								"type": "string",
								"description": "Category slug",
								"pattern": "^[a-z0-9-]+$"
							},
							"label": {
								"type": "string",
								"description": "Category display name"
							}
						},
						"required": ["slug", "label"]
					}
				},
				"style_variations": {
					"type": "object",
					"description": "Style variation files to include",
					"properties": {
						"global": {
							"type": "array",
							"description": "Global style variations (in styles/)",
							"default": ["dark"],
							"items": {
								"type": "string",
								"enum": [
									"dark",
									"light-contrast",
									"high-contrast"
								]
							}
						},
						"block_styles": {
							"type": "array",
							"description": "Block-specific style variations (in styles/blocks/)",
							"default": [
								"button-primary",
								"button-rounded",
								"heading-serif"
							],
							"items": {
								"type": "string",
								"enum": [
									"button-primary",
									"button-secondary",
									"button-rounded",
									"button-outline",
									"heading-serif",
									"heading-condensed",
									"image-rounded",
									"image-shadow"
								]
							}
						},
						"section_styles": {
							"type": "array",
							"description": "Section-specific style variations (in styles/sections/)",
							"default": ["hero-section", "content-section"],
							"items": {
								"type": "string",
								"enum": [
									"hero-section",
									"hero-overlay",
									"content-section",
									"cta-section",
									"testimonials-section",
									"features-section"
								]
							}
						}
					}
				}
			}
		},
		"features": {
			"type": "object",
			"description": "Optional theme features to enable",
			"properties": {
				"editor_styles": {
					"type": "boolean",
					"description": "Enable editor-specific styles",
					"default": true
				},
				"post_thumbnails": {
					"type": "boolean",
					"description": "Enable featured images",
					"default": true
				},
				"custom_logo": {
					"type": "boolean",
					"description": "Enable custom logo support",
					"default": true
				},
				"html5_support": {
					"type": "array",
					"description": "HTML5 markup support",

#!/usr/bin/env sh

# Pre-commit hook for the block theme scaffold tooling.
# Theme files live in theme-template/ and contain mustache placeholders,
# so they are validated by the generator tests rather than linted directly.

. "$(dirname -- "$0")/_/husky.sh"

echo "🟡 Linting tooling scripts..."
npm run lint || {
    echo "❌ Linting failed. Run 'npm run lint:js:fix' to auto-fix many issues."
    echo "💡 To bypass this check (not recommended), use: git commit --no-verify"
    exit 1
}

echo "🧪 Running tests related to staged changes..."
npx jest --runInBand --bail --findRelatedTests --passWithNoTests $(git diff --cached --name-only --diff-filter=ACM -- 'scripts/*.js' 'scripts/**/*.js') || {
    echo "❌ Tests failed. Run 'npm test' to see all failures."
    echo "💡 To bypass this check (not recommended), use: git commit --no-verify"
    exit 1
}

echo "✅ Pre-commit checks passed!"

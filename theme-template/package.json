{
	"name": "{{theme_slug}}",
	"version": "{{version}}",
	"description": "{{description}}",
	"author": "{{author}}",
	"license": "{{license}}",
	"keywords": [
		"wordpress",
		"gutenberg",
		"block-theme",
		"full-site-editing",
		"fse",
		"{{theme_slug}}"
	],
	"homepage": "{{theme_uri}}",
	"repository": {
		"type": "git",
		"url": "{{theme_repo_url}}"
	},
	"bugs": {
		"url": "{{theme_repo_url}}/issues"
	},
	"engines": {
		"node": ">=24.18.0",
		"npm": ">=11.16.0"
	},
	"dependencies": {
		"@wordpress/a11y": "^4.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/dom-ready": "^4.57.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/escape-html": "^3.57.0",
		"@wordpress/hooks": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/plugins": "^7.57.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.1",
		"@size-limit/file": "^11.2.0",
		"@vitest/coverage-v8": "^5.0.5",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^36.1.0",
		"ajv": "^8.20.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"ignore": "^7.0.14",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"size-limit": "^11.2.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build": "wp-scripts build",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"format": "wp-scripts format",
		"i18n": "npm run makepot && npm run makejson",
		"lighthouse": "lhci autorun",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:pkg && npm run lint:json",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:json": "node bin/validate-json.js",
		"lint:php": "composer run lint",
		"lint:pkg": "wp-scripts lint-pkg-json",
		"makejson": "wp i18n make-json languages --no-purge",
		"makepot": "wp i18n make-pot . languages/{{theme_slug}}.pot --slug={{theme_slug}} --domain={{theme_slug}} --exclude=node_modules,vendor,build,tests",
		"packages-update": "wp-scripts packages-update",
		"prepare": "husky",
		"size-limit": "size-limit",
		"start": "wp-scripts start",
		"test": "npm run test:unit",
		"test:e2e": "wp-scripts test-playwright",
		"test:unit": "wp-scripts test-unit-js"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs}": [
			"wp-scripts lint-js --fix",
			"wp-scripts format"
		],
		"*.{css,scss}": [
			"wp-scripts lint-style --fix"
		],
		"*.php": [
			"composer run lint:fix"
		],
		"package.json": [
			"wp-scripts lint-pkg-json"
		],
		"{theme.json,styles/**/*.json}": [
			"node bin/validate-json.js"
		]
	},
	"themeMeta": {
		"displayName": "{{theme_name}}",
		"namespace": "{{theme_slug}}",
		"website": "{{theme_uri}}",
		"docs": "{{docs_url}}",
		"support": "{{support_url}}",
		"changelog": "{{changelog_url}}",
		"repositoryType": "git",
		"repositoryUrl": "{{theme_repo_url}}",
		"created": "{{created_date}}",
		"updated": "{{updated_date}}"
	}
}

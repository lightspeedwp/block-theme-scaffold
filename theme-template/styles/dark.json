{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "{{dark_mode_title}}",
	"settings": {
		"custom": {
			"color": {
				"text": {
					"default": "var(--wp--preset--color--neutral-100)",
					"muted": "var(--wp--preset--color--neutral-400)",
					"inverse": "var(--wp--preset--color--contrast)",
					"brand": "var(--wp--preset--color--brand-300)",
					"link": "var(--wp--preset--color--brand-300)",
					"link-hover": "var(--wp--preset--color--primary-300)",
					"disabled": "var(--wp--preset--color--neutral-600)",
					"inverse-subtle": "var(--wp--preset--color--neutral-800)",
					"placeholder": "var(--wp--preset--color--neutral-400)"
				},
				"surface": {
					"default": "var(--wp--preset--color--neutral-900)",
					"subtle": "var(--wp--preset--color--neutral-800)",
					"brand": "var(--wp--preset--color--brand-900)",
					"inverse": "var(--wp--preset--color--base)",
					"overlay": "var(--wp--custom--color--overlay)",
					"control-checked": "var(--wp--preset--color--brand-400)",
					"control-off": "var(--wp--preset--color--neutral-600)",
					"control-disabled": "var(--wp--preset--color--neutral-700)"
				},
				"border": {
					"default": "var(--wp--preset--color--neutral-600)",
					"subtle": "var(--wp--preset--color--neutral-700)",
					"strong": "var(--wp--preset--color--neutral-400)",
					"focus": "var(--wp--preset--color--brand-300)",
					"focus-inverse": "var(--wp--preset--color--brand-600)",
					"divider": "var(--wp--preset--color--neutral-800)"
				},
				"action": {
					"primary": {
						"background": "var(--wp--preset--color--primary-300)",
						"background-hover": "var(--wp--preset--color--primary-200)",
						"text": "var(--wp--preset--color--contrast)"
					},
					"secondary": {
						"background": "var(--wp--preset--color--brand-300)",
						"background-hover": "var(--wp--preset--color--brand-200)",
						"text": "var(--wp--preset--color--contrast)"
					},
					"cta": {
						"background": "var(--wp--preset--color--cta-300)",
						"background-hover": "var(--wp--preset--color--cta-200)",
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				"feedback": {
					"error": {
						"text": "color-mix(in srgb, var(--wp--preset--color--error-foreground) 60%, var(--wp--preset--color--base))",
						"background": "var(--wp--preset--color--error-background)",
						"border": "color-mix(in srgb, var(--wp--preset--color--error-foreground) 60%, var(--wp--preset--color--base))"
					},
					"warning": {
						"text": "color-mix(in srgb, var(--wp--preset--color--warning-foreground) 60%, var(--wp--preset--color--base))",
						"background": "var(--wp--preset--color--warning-background)",
						"border": "color-mix(in srgb, var(--wp--preset--color--warning-foreground) 60%, var(--wp--preset--color--base))"
					},
					"success": {
						"text": "color-mix(in srgb, var(--wp--preset--color--success-foreground) 60%, var(--wp--preset--color--base))",
						"background": "var(--wp--preset--color--success-background)",
						"border": "color-mix(in srgb, var(--wp--preset--color--success-foreground) 60%, var(--wp--preset--color--base))"
					},
					"info": {
						"text": "color-mix(in srgb, var(--wp--preset--color--information-foreground) 60%, var(--wp--preset--color--base))",
						"background": "var(--wp--preset--color--information-background)",
						"border": "color-mix(in srgb, var(--wp--preset--color--information-foreground) 60%, var(--wp--preset--color--base))"
					}
				},
				"overlay": "color-mix(in srgb, var(--wp--preset--color--contrast) 60%, transparent)"
			}
		}
	}
}

		"custom": {
			"color": {
				"text": {
					"default": "var(--wp--preset--color--neutral-100)",
					"muted": "var(--wp--preset--color--neutral-400)",
					"inverse": "var(--wp--preset--color--contrast)",
					"brand": "var(--wp--preset--color--brand-300)",
					"link": "var(--wp--preset--color--brand-300)",
					"link-hover": "var(--wp--preset--color--primary-300)",
					"disabled": "var(--wp--preset--color--neutral-600)",
					"inverse-subtle": "var(--wp--preset--color--neutral-800)",
					"placeholder": "var(--wp--preset--color--neutral-400)"
				},
				"surface": {
					"default": "var(--wp--preset--color--neutral-900)",
					"subtle": "var(--wp--preset--color--neutral-800)",
					"brand": "var(--wp--preset--color--brand-900)",
					"inverse": "var(--wp--preset--color--base)",
					"overlay": "var(--wp--custom--color--overlay)",
					"control-checked": "var(--wp--preset--color--brand-400)",
					"control-off": "var(--wp--preset--color--neutral-600)",
					"control-disabled": "var(--wp--preset--color--neutral-700)"
				},
				"border": {
					"default": "var(--wp--preset--color--neutral-600)",
					"subtle": "var(--wp--preset--color--neutral-700)",
					"strong": "var(--wp--preset--color--neutral-400)",
					"focus": "var(--wp--preset--color--brand-300)",
					"focus-inverse": "var(--wp--preset--color--brand-600)",
					"divider": "var(--wp--preset--color--neutral-800)"
				},
				"action": {
					"primary": {
						"background": "var(--wp--preset--color--primary-300)",
						"background-hover": "var(--wp--preset--color--primary-200)",
						"text": "var(--wp--preset--color--contrast)"
					},
					"secondary": {
						"background": "var(--wp--preset--color--brand-300)",
						"background-hover": "var(--wp--preset--color--brand-200)",
						"text": "var(--wp--preset--color--contrast)"
					},
					"cta": {
						"background": "var(--wp--preset--color--cta-300)",
						"background-hover": "var(--wp--preset--color--cta-200)",
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				"feedback": {
					"error": {
						"text": "#fca5a5",
						"background": "var(--wp--preset--color--neutral-800)",
						"border": "#fca5a5"
					},
					"warning": {
						"text": "var(--wp--preset--color--warning-foreground)",
						"background": "var(--wp--preset--color--neutral-800)",
						"border": "var(--wp--preset--color--warning-foreground)"
					},
					"success": {
						"text": "#4ade80",
						"background": "var(--wp--preset--color--neutral-800)",
						"border": "#4ade80"
					},
					"info": {
						"text": "#93c5fd",
						"background": "var(--wp--preset--color--neutral-800)",
						"border": "#93c5fd"
					}
				}
			}

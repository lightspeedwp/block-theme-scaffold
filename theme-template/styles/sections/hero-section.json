{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "{{hero_section_style_title}}",
	"slug": "hero-section",
	"blockTypes": [ "core/cover" ],
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--background)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--80)",
				"bottom": "var(--wp--preset--spacing--80)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--800)",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			}
		},
		"dimensions": {
			"aspectRatio": "16/9",
			"minHeight": "400px"
		},
		"css": "& { position: relative; }\n@supports (aspect-ratio: 16 / 9) { & { aspect-ratio: 16/9; } }"
	}
}

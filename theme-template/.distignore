# Files left out of a theme release (bin/package-release.js).

# Git and GitHub
.git/
.github/
.gitignore
.gitattributes

# Dependencies
node_modules/
vendor/

# Source (build/ ships)
src/

# Tests and their output
tests/
coverage/
artifacts/
test-results/
playwright-report/
.phpunit.cache/
.phpunit.result.cache

# Tool configuration
package.json
package-lock.json
composer.json
composer.lock
webpack.config.js
eslint.config.cjs
.prettierrc.js
.prettierignore
.stylelintrc.json
.stylelintignore
.browserslistrc
.editorconfig
.npmrc
.nvmrc
vitest.config.mjs
playwright.config.js
phpcs.xml
phpstan.neon
phpunit.xml
.wp-env.json
.lighthouserc.js
.size-limit.json
.husky/

# Build scripts, generator config and release output
bin/
dist/
{{theme_slug}}-config.json

# Documentation (README.txt, readme and changelog ship)
*.md
!README.md
!CHANGELOG.md
docs/

# Logs, caches and system files
*.log
*.lock
.cache/
tmp/
logs/
lighthouse-reports/
.DS_Store
Thumbs.db
.env
.env.*

# This file
.distignore

					"fontWeight": "{{heading_font_weight}}",
					"lineHeight": "{{heading_line_height}}"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--custom--color--text--link)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--custom--color--border--focus)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--custom--color--border--focus)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				},
				":visited": {
					"color": {
						"text": "var(--wp--custom--color--text--link)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--custom--color--action--primary--background)",
					"text": "var(--wp--custom--color--action--primary--text)"
				},
				"typography": {
					"fontWeight": "{{button_font_weight}}"
				},
				"border": {
					"radius": "{{button_border_radius}}"
				},
				":hover": {
					"color": {
						"background": "var(--wp--custom--color--action--primary--background-hover)",
						"text": "var(--wp--custom--color--action--primary--text)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--custom--color--action--primary--background-hover)",
						"text": "var(--wp--custom--color--action--primary--text)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--custom--color--border--focus)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--custom--color--border--focus)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			}
		},
		"css": "/* Enhanced theme styles and custom fallbacks */\n.wp-block-button__link { transition: all 0.3s ease; }\n.wp-block-button:focus-within .wp-block-button__link { outline: 2px solid var(--wp--custom--color--border--focus); outline-offset: 2px; }\n@supports (aspect-ratio: 1) { .wp-block-image img { aspect-ratio: var(--aspect-ratio); } }\n@supports (box-shadow: 0 0 0 var(--wp--preset--shadow--small)) { .wp-block-quote { box-shadow: var(--wp--preset--shadow--x-small); } }",
		"blocks": {
			"core/navigation": {

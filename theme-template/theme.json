			"text": "var(--wp--custom--color--text--default)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--200)",
			"lineHeight": "{{body_line_height}}"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},

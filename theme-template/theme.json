						"border": "var(--wp--preset--color--error-foreground)"
					},
					"warning": {
						"text": "var(--wp--preset--color--warning-foreground)",
						"background": "var(--wp--preset--color--warning-background)",
						"border": "var(--wp--preset--color--warning-foreground)"
					},
					"success": {
						"text": "var(--wp--preset--color--success-foreground)",
						"background": "var(--wp--preset--color--success-background)",
						"border": "var(--wp--preset--color--success-foreground)"
					},
					"info": {
						"text": "var(--wp--preset--color--information-foreground)",
						"background": "var(--wp--preset--color--information-background)",
						"border": "var(--wp--preset--color--information-foreground)"
					}
				},
				"overlay": "#11111140"
			},

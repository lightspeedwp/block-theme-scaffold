						"text": "var(--wp--preset--color--base)"
					},
					"secondary": {
						"background": "var(--wp--preset--color--brand-600)",
						"background-hover": "var(--wp--preset--color--brand-700)",
						"text": "var(--wp--preset--color--base)"
					},
					"cta": {
						"background": "var(--wp--preset--color--cta-500)",

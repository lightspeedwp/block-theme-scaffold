					"control-off": "var(--wp--preset--color--neutral-500)",
					"control-disabled": "var(--wp--preset--color--neutral-200)"
				},
				"border": {
					"default": "var(--wp--preset--color--neutral-500)",
					"subtle": "var(--wp--preset--color--neutral-400)",
					"strong": "var(--wp--preset--color--neutral-700)",
					"focus": "var(--wp--preset--color--brand-600)",
